# Copy to .env for local development.
#
# These two values are PUBLIC — they ship in the client bundle and are safe to
# expose, but ONLY because row-level security is enabled on every table.
# RLS correctness is the entire security model. See docs/ARCHITECTURE.md.
#
# The sb_secret_... key must NEVER appear here, in the bundle, or in the repo.
# It lives only in GitHub Actions secrets.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
